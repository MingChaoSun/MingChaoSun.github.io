---
// Fixed 中/EN toggle. The button shows the language you will switch TO.
// State is applied early (Layout head script) and persisted in localStorage.
---
<button id="langToggle" class="lang-toggle mono" type="button" aria-label="Switch language / 切换语言">
  <span class="i18n i18n-en">中</span><span class="i18n i18n-zh">EN</span>
</button>

<style>
  .lang-toggle {
    position: fixed;
    top: clamp(0.8rem, 2vw, 1.2rem);
    right: clamp(0.8rem, 2vw, 1.2rem);
    z-index: 100;
    display: inline-flex;
    align-items: center;
    background: rgba(17, 21, 29, 0.95);
    border: 1px solid var(--border);
    color: var(--accent);
    padding: 0.42em 0.8em;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    box-shadow: 0 6px 24px -10px rgba(0, 0, 0, 0.7);
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .lang-toggle:hover {
    border-color: var(--accent);
  }
</style>
