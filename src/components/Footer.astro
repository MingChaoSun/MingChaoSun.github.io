---
import { profile } from '../data/site';
const year = new Date().getFullYear();
// an old motto — Mingchao's undergrad signature
const motto = 'pushing hard && beyond the limit -> embrace Dream!';
---

<footer class="footer">
  <p class="container footer__motto mono dim">{motto}</p>
  <div class="container footer__inner mono">
    <span class="dim">© {year} {profile.name}</span>
    <span class="dim">
      <span class="i18n i18n-en">built with</span>
      <span class="i18n i18n-zh">由</span>{' '}
      <a href="https://astro.build">astro</a>{' '}·{' '}
      <span class="i18n i18n-en">deployed on</span>
      <span class="i18n i18n-zh">部署于</span>{' '}
      <a href="https://pages.github.com">github pages</a>
    </span>
    <a href="#top" class="footer__top">
      ↑ <span class="i18n i18n-en">top</span><span class="i18n i18n-zh">顶部</span>
    </a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-soft);
    padding-block: 1.8rem;
    margin-top: 2rem;
    position: relative;
    z-index: 1;
  }
  .footer__motto {
    text-align: center;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    margin-bottom: 1.25rem;
    opacity: 0.75;
  }
  .footer__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.8rem;
  }
  .footer__top {
    color: var(--accent);
  }
</style>
