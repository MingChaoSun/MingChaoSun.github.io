---
import { profile, focusAreas } from '../data/site';

const slug = profile.name.toLowerCase().replace(/\s+/g, '');
---

<section class="hero" id="top">
  <div class="hero__fx" aria-hidden="true"><canvas id="hero-canvas"></canvas></div>
  <div class="container hero__inner">
    <div class="hero__id" data-reveal>
      <img class="hero__avatar" src="/avatar.jpg" alt={profile.name} width="96" height="96" loading="eager" />
    </div>

    <div class="terminal" data-reveal>
      <div class="terminal__bar">
        <span class="dot dot--red"></span>
        <span class="dot dot--amber"></span>
        <span class="dot dot--green"></span>
        <span class="terminal__title mono">~/{slug} — zsh</span>
      </div>
      <pre class="terminal__body mono"><code><span class="prompt"></span>whoami <span class="dim">--research</span>
<span class="out-name">{profile.name}</span>
<span class="out-role"><span class="i18n i18n-en">{profile.role}</span><span class="i18n i18n-zh">{profile.roleZh}</span></span>
<span class="out-aff"><span class="i18n i18n-en">{profile.affiliation}</span><span class="i18n i18n-zh">{profile.affiliationZh}</span></span>

<span class="prompt"></span>cat ./about.txt
<span class="muted"><span class="i18n i18n-en">{profile.tagline.en}</span><span class="i18n i18n-zh">{profile.tagline.zh}</span></span>

<span class="prompt"></span>ls ./focus
<span class="out-focus">{focusAreas.join('  ')}</span>

<span class="prompt"></span>scholar <span class="dim">--stats</span>
<span class="muted">citations: {profile.stats.citations.toLocaleString('en-US')}  ·  h-index: {profile.stats.hIndex}  ·  i10: {profile.stats.i10Index}</span>

<span class="prompt"></span><span class="cursor" aria-hidden="true"></span></code></pre>
    </div>

    <div class="hero__cta" data-reveal>
      <a class="btn btn--primary" href="#work"><span class="i18n i18n-en">view selected work</span><span class="i18n i18n-zh">查看代表论文</span></a>
      <a class="btn btn--ghost" href="#contact"><span class="i18n i18n-en">get in touch</span><span class="i18n i18n-zh">联系我</span></a>
    </div>

    <a class="hero__scroll" href="#about" aria-label="Scroll to content">
      <span class="hero__scroll-txt mono">
        <span class="i18n i18n-en">scroll</span><span class="i18n i18n-zh">向下滚动</span>
      </span>
      <span class="hero__mouse" aria-hidden="true"><span class="hero__wheel"></span></span>
    </a>
  </div>
</section>

<script>
  // ---- Lightweight 2D interactive point-cloud (nod to point-cloud DL / 3DGS) ----
  // Particles drift; near the cursor they brighten and link into a constellation.
  // Guarded: reduced-motion → single static frame; pauses off-screen / tab-hidden.
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  const hero = document.querySelector('.hero') as HTMLElement | null;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && hero && canvas.getContext) {
    const ctx = canvas.getContext('2d')!;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);

    // palette
    const MINT: [number, number, number] = [74, 227, 181]; // --accent
    const BLUE: [number, number, number] = [122, 162, 247]; // --accent-2

    let w = 0, h = 0;
    type P = { x: number; y: number; vx: number; vy: number; r: number; t: number; base: [number, number, number] };
    let pts: P[] = [];

    // mouse in CSS pixels, relative to hero
    const mouse = { x: -9999, y: -9999, on: false };
    const REACH = 180; // px — radius of cursor influence
    const LINK = 132; // px — max distance to draw a link between two near-cursor points
    const REACH2 = REACH * REACH;
    const LINK2 = LINK * LINK;

    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    // a point's idle color (mint→blue by t) is constant — precompute it once
    const baseColor = (t: number): [number, number, number] => [
      (lerp(MINT[0], BLUE[0], t) + 0.5) | 0,
      (lerp(MINT[1], BLUE[1], t) + 0.5) | 0,
      (lerp(MINT[2], BLUE[2], t) + 0.5) | 0,
    ];

    // cached cursor-glow gradient — rebuilt only when the cursor actually moves
    let glowGrad: CanvasGradient | null = null;
    let glowKey = '';

    const seed = (n: number) => {
      pts = Array.from({ length: n }, () => {
        const t = Math.random();
        return {
          x: Math.random() * w,
          y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.22,
          vy: (Math.random() - 0.5) * 0.22,
          r: Math.random() * 1.1 + 0.7,
          t,
          base: baseColor(t),
        };
      });
    };

    const resize = () => {
      w = hero.clientWidth;
      h = hero.clientHeight;
      canvas.width = Math.max(1, Math.round(w * dpr));
      canvas.height = Math.max(1, Math.round(h * dpr));
      canvas.style.width = w + 'px';
      canvas.style.height = h + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const target = Math.min(96, Math.max(36, Math.round((w * h) / 17000)));
      if (pts.length !== target) seed(target);
    };

    const render = () => {
      ctx.clearRect(0, 0, w, h);

      // soft glow hugging the cursor (gradient cached per cursor position)
      if (mouse.on) {
        const key = mouse.x + ',' + mouse.y;
        if (key !== glowKey) {
          const g = ctx.createRadialGradient(mouse.x, mouse.y, 0, mouse.x, mouse.y, REACH);
          g.addColorStop(0, 'rgba(74,227,181,0.10)');
          g.addColorStop(1, 'rgba(74,227,181,0)');
          glowGrad = g;
          glowKey = key;
        }
        ctx.fillStyle = glowGrad!;
        ctx.beginPath();
        ctx.arc(mouse.x, mouse.y, REACH, 0, Math.PI * 2);
        ctx.fill();
      }

      // points near the cursor — for linking
      const near: P[] = [];
      if (mouse.on) {
        for (const p of pts) {
          const dx = p.x - mouse.x, dy = p.y - mouse.y;
          if (dx * dx + dy * dy < REACH2) near.push(p);
        }
      }

      // constellation links among near-cursor points
      if (near.length > 1) {
        ctx.lineWidth = 1;
        for (let i = 0; i < near.length; i++) {
          const a = near[i];
          for (let j = i + 1; j < near.length; j++) {
            const b = near[j];
            const dx = a.x - b.x, dy = a.y - b.y;
            const d2 = dx * dx + dy * dy;
            if (d2 < LINK2) {
              const alpha = (1 - Math.sqrt(d2) / LINK) * 0.5;
              ctx.strokeStyle = 'rgba(74,227,181,' + alpha + ')';
              ctx.beginPath();
              ctx.moveTo(a.x, a.y);
              ctx.lineTo(b.x, b.y);
              ctx.stroke();
            }
          }
        }
      }

      // draw all points; brighten those near the cursor
      for (const p of pts) {
        let hot = 0;
        if (mouse.on) {
          const dx = p.x - mouse.x, dy = p.y - mouse.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < REACH2) hot = 1 - Math.sqrt(d2) / REACH; // 0..1
        }
        // brighten the precomputed idle color toward white by `hot`
        const b = p.base;
        const rr = (b[0] + (255 - b[0]) * hot * 0.4) | 0;
        const gg = (b[1] + (255 - b[1]) * hot * 0.4) | 0;
        const bb = (b[2] + (255 - b[2]) * hot * 0.4) | 0;
        const a = 0.35 + hot * 0.6 + p.t * 0.05;
        const rad = p.r * (1 + hot * 1.8);
        ctx.fillStyle = 'rgba(' + rr + ',' + gg + ',' + bb + ',' + (a > 1 ? 1 : a) + ')';
        ctx.beginPath();
        ctx.arc(p.x, p.y, rad, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    const step = () => {
      for (const p of pts) {
        p.x += p.vx;
        p.y += p.vy;
        // wrap around the hero edges
        if (p.x < -10) p.x = w + 10;
        else if (p.x > w + 10) p.x = -10;
        if (p.y < -10) p.y = h + 10;
        else if (p.y > h + 10) p.y = -10;
      }
      render();
    };

    let raf = 0;
    let visible = true;
    let inView = true;

    const loop = () => {
      if (!visible || !inView) return;
      step();
      raf = requestAnimationFrame(loop);
    };

    const start = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(loop);
    };
    const stop = () => cancelAnimationFrame(raf);

    // pointer → hero-relative coords (canvas is pointer-events:none).
    // cache the hero rect; refresh on scroll/resize so we don't re-layout per move.
    let rect = hero.getBoundingClientRect();
    const onMove = (e: PointerEvent) => {
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
      mouse.on = mouse.x >= 0 && mouse.x <= w && mouse.y >= 0 && mouse.y <= h;
    };
    const onLeave = () => {
      mouse.on = false;
      mouse.x = mouse.y = -9999;
    };
    window.addEventListener('pointermove', onMove, { passive: true });
    window.addEventListener('pointerout', onLeave, { passive: true });

    // pause when hero scrolled out of view
    const io = new IntersectionObserver(
      (entries) => {
        inView = entries[0]?.isIntersecting ?? true;
        if (inView && visible && !reduce) start();
        else stop();
      },
      { threshold: 0.01 },
    );
    io.observe(hero);

    // pause when tab hidden
    document.addEventListener('visibilitychange', () => {
      visible = document.visibilityState === 'visible';
      if (visible && inView && !reduce) start();
      else stop();
    });

    resize();
    window.addEventListener('resize', () => { rect = hero.getBoundingClientRect(); resize(); }, { passive: true });
    window.addEventListener('scroll', () => { rect = hero.getBoundingClientRect(); }, { passive: true });

    if (reduce) {
      // static frame: park a constellation in the centre so it still reads
      mouse.on = true;
      mouse.x = w / 2;
      mouse.y = h * 0.42;
      render();
    } else {
      start();
    }
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(3rem, 9vw, 6rem) clamp(2rem, 5vw, 3rem);
  }
  .hero__fx {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* keep the cloud visible across the hero, just feather the very edges */
    -webkit-mask-image: radial-gradient(135% 120% at 50% 38%, #000 58%, transparent 95%);
    mask-image: radial-gradient(135% 120% at 50% 38%, #000 58%, transparent 95%);
  }
  .hero__fx canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }
  .hero__id {
    display: flex;
    justify-content: center;
  }
  .hero__avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border);
    box-shadow:
      0 0 0 6px rgba(74, 227, 181, 0.05),
      0 10px 30px -10px rgba(0, 0, 0, 0.6);
  }
  .terminal {
    /* translucent (NOT backdrop-filtered) so the point-cloud reads through it
       without paying a per-frame blur cost over the animating canvas. */
    background: rgba(13, 17, 23, 0.72);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow:
      0 20px 60px -20px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(255, 255, 255, 0.02) inset;
  }
  .terminal__bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 0.9rem;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--border-soft);
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
  }
  .dot--red { background: #ff5f57; }
  .dot--amber { background: #febc2e; }
  .dot--green { background: #28c840; }
  .terminal__title {
    color: var(--text-dim);
    font-size: 0.78rem;
    margin-left: 0.6rem;
  }
  .terminal__body {
    margin: 0;
    padding: clamp(1rem, 3vw, 1.6rem);
    font-size: clamp(0.82rem, 2.2vw, 0.95rem);
    line-height: 1.85;
    overflow-x: auto;
    white-space: pre;
    color: var(--text);
  }
  .terminal__body code {
    font-family: inherit;
    background: none;
    border: none;
    padding: 0;
  }
  .out-name { color: var(--accent); font-weight: 700; }
  .out-role { color: var(--text); }
  .out-aff { color: var(--text-muted); }
  .out-focus { color: var(--accent-2); }
  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.05em;
    background: var(--accent);
    vertical-align: text-bottom;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  .hero__cta {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
  .btn {
    font-family: var(--mono);
    font-size: 0.88rem;
    padding: 0.7em 1.2em;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    transition: all 0.2s var(--ease);
  }
  .btn--primary {
    background: var(--accent);
    color: #062018;
    border-color: var(--accent);
    font-weight: 600;
  }
  .btn--primary:hover {
    background: #6cf0c6;
    text-decoration: none;
    transform: translateY(-1px);
  }
  .btn--ghost {
    color: var(--text);
    background: transparent;
  }
  .btn--ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }

  /* scroll cue */
  .hero__scroll {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.4rem;
    color: var(--text-dim);
    text-decoration: none;
    align-self: center;
  }
  .hero__scroll-txt {
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .hero__mouse {
    width: 22px;
    height: 34px;
    border: 1.5px solid var(--border);
    border-radius: 12px;
    display: flex;
    justify-content: center;
    padding-top: 6px;
  }
  .hero__wheel {
    width: 3px;
    height: 7px;
    border-radius: 2px;
    background: var(--accent);
    animation: scrollwheel 1.6s var(--ease) infinite;
  }
  @keyframes scrollwheel {
    0% { opacity: 0; transform: translateY(-3px); }
    35% { opacity: 1; }
    70% { opacity: 0; transform: translateY(7px); }
    100% { opacity: 0; }
  }
  .hero__scroll:hover {
    color: var(--accent);
  }
  .hero__scroll:hover .hero__mouse {
    border-color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__fx { opacity: 0.85; }
    .hero__wheel { animation: none; }
  }
  @media (max-width: 560px) {
    .hero__scroll { display: none; }
  }
</style>
