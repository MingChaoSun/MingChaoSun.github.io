---
import { profile } from '../data/site';

const scholar = profile.socials.find((s) => s.label === 'Google Scholar');
const email = profile.socials.find((s) => s.label === 'Email');
---

<section class="hero" id="top">
  <div class="hero__fx" aria-hidden="true"><canvas id="hero-canvas"></canvas></div>

  <div class="container hero__inner">
    <div class="hero__content" data-reveal>
      <img class="hero__avatar" src="/avatar.jpg" alt={profile.name} width="96" height="96" loading="eager" />
      <h1 class="hero__name">{profile.name}</h1>
      <p class="hero__role">Researcher · {profile.affiliation}</p>
      <p class="hero__lede">{profile.tagline.en}</p>

      <div class="hero__socials">
        {scholar && (
          <a class="hero__social-link" href={scholar.url} target="_blank" rel="noopener noreferrer" title="Google Scholar">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 1 0 0-14z"></path></svg>
            Scholar
          </a>
        )}
        <button class="hero__social-link" type="button" data-copy={profile.wechat} title="Copy WeChat ID">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8.6 3C4 3 0 6.1 0 10.1c0 2.2 1.1 4.2 3 5.5l-1 2.9 3.3-1.7c1.1.3 2.2.4 3.3.4.1 0 .2 0 .3 0-1-4.2 2-7.8 6.4-7.8.4 0 .8 0 1.2.1C15 5.7 12 3 8.6 3zm-2.4 4c.6 0 1.1.5 1.1 1.1C7.3 8.7 6.8 9.1 6.2 9.1 5.6 9.1 5.1 8.7 5.1 8.1 5.1 7.6 5.6 7 6.2 7zm4.8 0c.6 0 1.1.5 1.1 1.1 0 .6-.5 1.1-1.1 1.1-.6 0-1.1-.5-1.1-1.1C9.9 7.6 10.4 7 11 7zM17.1 10.3c-3.5 0-6.4 2.4-6.4 5.4 0 3 2.9 5.4 6.4 5.4 1 0 2-.2 2.9-.6l2.9 1.5-.9-2.5c1.6-1.1 2.6-2.8 2.6-4.7 0-3-2.9-5.5-6.4-5.5zm-2.1 3.5c.5 0 .9.4.9.9s-.4.9-.9.9-.9-.4-.9-.9.4-.9.9-.9zm4.2 0c.5 0 .9.4.9.9s-.4.9-.9.9-.9-.4-.9-.9.4-.9.9-.9z"></path></svg>
            <span data-label>WeChat</span>
        </button>
        {email && (
          <a class="hero__social-link" href={email.url} title="Email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            Email
          </a>
        )}
      </div>

      <div class="hero__cta">
        <a class="btn btn--primary" href="#work">view selected work</a>
      </div>
    </div>
  </div>

  <a class="hero__scroll" href="#about" aria-label="Scroll to content">
    <span class="hero__scroll-txt mono">scroll</span>
    <span class="hero__mouse" aria-hidden="true"><span class="hero__wheel"></span></span>
  </a>
</section>

<script>
  // ---- Lightweight 2D interactive point-cloud (nod to point-cloud DL / 3DGS) ----
  // Static by default; drifts + forms a constellation only while the cursor is
  // inside the hero. Paused off-screen / tab-hidden. reduced-motion → static.
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  const hero = document.querySelector('.hero') as HTMLElement | null;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && hero && canvas.getContext) {
    const ctx = canvas.getContext('2d')!;
    const dpr = Math.min(window.devicePixelRatio || 1, 1.5);

    // palette
    const MINT: [number, number, number] = [74, 227, 181]; // --accent
    const BLUE: [number, number, number] = [122, 162, 247]; // --accent-2

    let w = 0, h = 0;
    type P = { x: number; y: number; vx: number; vy: number; r: number; t: number; base: [number, number, number] };
    let pts: P[] = [];

    // mouse in CSS pixels, relative to hero
    const mouse = { x: -9999, y: -9999, on: false };
    const REACH = 180; // px — radius of cursor influence
    const LINK = 132; // px — max distance to draw a link between two near-cursor points
    const REACH2 = REACH * REACH;
    const LINK2 = LINK * LINK;

    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    // a point's idle color (mint→blue by t) is constant — precompute it once
    const baseColor = (t: number): [number, number, number] => [
      (lerp(MINT[0], BLUE[0], t) + 0.5) | 0,
      (lerp(MINT[1], BLUE[1], t) + 0.5) | 0,
      (lerp(MINT[2], BLUE[2], t) + 0.5) | 0,
    ];

    // cached cursor-glow gradient — rebuilt only when the cursor actually moves
    let glowGrad: CanvasGradient | null = null;
    let glowKey = '';

    const seed = (n: number) => {
      pts = Array.from({ length: n }, () => {
        const t = Math.random();
        return {
          x: Math.random() * w,
          y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.22,
          vy: (Math.random() - 0.5) * 0.22,
          r: Math.random() * 1.1 + 0.7,
          t,
          base: baseColor(t),
        };
      });
    };

    const resize = () => {
      w = hero.clientWidth;
      h = hero.clientHeight;
      canvas.width = Math.max(1, Math.round(w * dpr));
      canvas.height = Math.max(1, Math.round(h * dpr));
      canvas.style.width = w + 'px';
      canvas.style.height = h + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const target = Math.min(96, Math.max(36, Math.round((w * h) / 17000)));
      if (pts.length !== target) seed(target);
    };

    const render = () => {
      ctx.clearRect(0, 0, w, h);

      // soft glow hugging the cursor (gradient cached per cursor position)
      if (mouse.on) {
        const key = mouse.x + ',' + mouse.y;
        if (key !== glowKey) {
          const g = ctx.createRadialGradient(mouse.x, mouse.y, 0, mouse.x, mouse.y, REACH);
          g.addColorStop(0, 'rgba(74,227,181,0.10)');
          g.addColorStop(1, 'rgba(74,227,181,0)');
          glowGrad = g;
          glowKey = key;
        }
        ctx.fillStyle = glowGrad!;
        ctx.beginPath();
        ctx.arc(mouse.x, mouse.y, REACH, 0, Math.PI * 2);
        ctx.fill();
      }

      // points near the cursor — for linking
      const near: P[] = [];
      if (mouse.on) {
        for (const p of pts) {
          const dx = p.x - mouse.x, dy = p.y - mouse.y;
          if (dx * dx + dy * dy < REACH2) near.push(p);
        }
      }

      // constellation links among near-cursor points
      if (near.length > 1) {
        ctx.lineWidth = 1;
        for (let i = 0; i < near.length; i++) {
          const a = near[i];
          for (let j = i + 1; j < near.length; j++) {
            const b = near[j];
            const dx = a.x - b.x, dy = a.y - b.y;
            const d2 = dx * dx + dy * dy;
            if (d2 < LINK2) {
              const alpha = (1 - Math.sqrt(d2) / LINK) * 0.5;
              ctx.strokeStyle = 'rgba(74,227,181,' + alpha + ')';
              ctx.beginPath();
              ctx.moveTo(a.x, a.y);
              ctx.lineTo(b.x, b.y);
              ctx.stroke();
            }
          }
        }
      }

      // draw all points; brighten those near the cursor
      for (const p of pts) {
        let hot = 0;
        if (mouse.on) {
          const dx = p.x - mouse.x, dy = p.y - mouse.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < REACH2) hot = 1 - Math.sqrt(d2) / REACH; // 0..1
        }
        // brighten the precomputed idle color toward white by `hot`
        const b = p.base;
        const rr = (b[0] + (255 - b[0]) * hot * 0.4) | 0;
        const gg = (b[1] + (255 - b[1]) * hot * 0.4) | 0;
        const bb = (b[2] + (255 - b[2]) * hot * 0.4) | 0;
        const a = 0.35 + hot * 0.6 + p.t * 0.05;
        const rad = p.r * (1 + hot * 1.8);
        ctx.fillStyle = 'rgba(' + rr + ',' + gg + ',' + bb + ',' + (a > 1 ? 1 : a) + ')';
        ctx.beginPath();
        ctx.arc(p.x, p.y, rad, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    const step = () => {
      for (const p of pts) {
        p.x += p.vx;
        p.y += p.vy;
        // wrap around the hero edges
        if (p.x < -10) p.x = w + 10;
        else if (p.x > w + 10) p.x = -10;
        if (p.y < -10) p.y = h + 10;
        else if (p.y > h + 10) p.y = -10;
      }
      render();
    };

    let raf = 0;
    let visible = true;
    let inView = true;
    let pointerIn = false; // the cloud only animates while the cursor is inside the hero

    // run only when: tab visible, hero on-screen, cursor inside, motion allowed.
    // Idle (no hover / scrolled away / hidden tab) → zero rAF cost.
    const shouldRun = () => visible && inView && pointerIn && !reduce;

    const loop = () => {
      if (!shouldRun()) return;
      step();
      raf = requestAnimationFrame(loop);
    };
    const start = () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(loop); };
    const stop = () => cancelAnimationFrame(raf);

    // pointer → hero-relative coords (canvas is pointer-events:none).
    // cache the hero rect; refresh on scroll/resize so we don't re-layout per move.
    let rect = hero.getBoundingClientRect();
    const onMove = (e: PointerEvent) => {
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
      const inside = mouse.x >= 0 && mouse.x <= w && mouse.y >= 0 && mouse.y <= h;
      mouse.on = inside;
      if (inside !== pointerIn) {
        pointerIn = inside;
        if (inside) { if (shouldRun()) start(); }
        else { stop(); if (inView) render(); } // repaint a clean static frame
      }
    };
    // pointer left the window entirely
    const onWinLeave = () => {
      if (!pointerIn) return;
      pointerIn = false;
      mouse.on = false;
      mouse.x = mouse.y = -9999;
      stop();
      if (inView) render();
    };
    window.addEventListener('pointermove', onMove, { passive: true });
    window.addEventListener('mouseout', (e) => { if (!e.relatedTarget) onWinLeave(); }, { passive: true });

    // pause when hero scrolled out of view
    const io = new IntersectionObserver(
      (entries) => {
        inView = entries[0]?.isIntersecting ?? true;
        if (shouldRun()) start(); else stop();
      },
      { threshold: 0.01 },
    );
    io.observe(hero);

    // pause when tab hidden
    document.addEventListener('visibilitychange', () => {
      visible = document.visibilityState === 'visible';
      if (shouldRun()) start(); else stop();
    });

    resize();
    window.addEventListener('resize', () => { rect = hero.getBoundingClientRect(); resize(); }, { passive: true });
    window.addEventListener('scroll', () => { rect = hero.getBoundingClientRect(); }, { passive: true });

    // render a single static frame up front; the cloud animates only while hovered
    if (reduce) {
      mouse.on = true;
      mouse.x = w / 2;
      mouse.y = h * 0.42;
    }
    render();
  }
</script>

<script>
  // click the WeChat chip → copy the ID to the clipboard, flash "copied"
  const wcBtn = document.querySelector('[data-copy]');
  if (wcBtn instanceof HTMLElement) {
    const label = wcBtn.querySelector('[data-label]');
    wcBtn.addEventListener('click', async () => {
      const id = wcBtn.getAttribute('data-copy') || '';
      let ok = false;
      try {
        await navigator.clipboard.writeText(id);
        ok = true;
      } catch {
        const ta = document.createElement('textarea');
        ta.value = id;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { ok = document.execCommand('copy'); } catch {}
        ta.remove();
      }
      if (ok && label) {
        const prev = label.textContent;
        label.textContent = 'copied: ' + id;
        wcBtn.classList.add('is-copied');
        setTimeout(() => {
          label.textContent = prev;
          wcBtn.classList.remove('is-copied');
        }, 1500);
      }
    });
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    min-height: min(82vh, 720px);
    display: flex;
    align-items: center;
    padding-block: clamp(3.5rem, 9vw, 6rem) clamp(4rem, 8vw, 6rem);
  }
  .hero__fx {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* keep the cloud visible across the hero, just feather the very edges */
    -webkit-mask-image: radial-gradient(135% 120% at 50% 38%, #000 58%, transparent 95%);
    mask-image: radial-gradient(135% 120% at 50% 38%, #000 58%, transparent 95%);
  }
  .hero__fx canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  .hero__content {
    max-width: 640px;
  }
  .hero__avatar {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border);
    box-shadow:
      0 0 0 6px rgba(74, 227, 181, 0.05),
      0 10px 30px -10px rgba(0, 0, 0, 0.6);
    margin-bottom: 1.3rem;
  }
  .hero__name {
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .hero__role {
    color: var(--text);
    font-weight: 600;
    font-size: clamp(1rem, 2.2vw, 1.18rem);
    margin-top: 0.55rem;
    letter-spacing: 0.01em;
  }
  .hero__lede {
    color: var(--text-muted);
    font-size: clamp(1.02rem, 2.4vw, 1.2rem);
    line-height: 1.6;
    max-width: 46ch;
    margin-top: 0.7rem;
  }

  .hero__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.4rem;
  }
  .hero__social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5em 0.9em;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.02);
    color: var(--text-muted);
    font-family: var(--mono);
    font-size: 0.82rem;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .hero__social-link svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
  .hero__social-link:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
    transform: translateY(-1px);
  }
  .hero__social-link.is-copied {
    color: var(--green);
    border-color: var(--green);
  }

  .hero__cta {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 1.6rem;
  }
  .btn {
    font-family: var(--mono);
    font-size: 0.88rem;
    padding: 0.7em 1.2em;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    transition: all 0.2s var(--ease);
  }
  .btn--primary {
    background: var(--accent);
    color: #062018;
    border-color: var(--accent);
    font-weight: 600;
  }
  .btn--primary:hover {
    background: #6cf0c6;
    text-decoration: none;
    transform: translateY(-1px);
  }
  .btn--ghost {
    color: var(--text);
    background: transparent;
  }
  .btn--ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }

  /* scroll cue pinned to the bottom of the hero */
  .hero__scroll {
    position: absolute;
    bottom: clamp(1rem, 3vw, 1.8rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-dim);
    text-decoration: none;
  }
  .hero__scroll-txt {
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .hero__mouse {
    width: 22px;
    height: 34px;
    border: 1.5px solid var(--border);
    border-radius: 12px;
    display: flex;
    justify-content: center;
    padding-top: 6px;
  }
  .hero__wheel {
    width: 3px;
    height: 7px;
    border-radius: 2px;
    background: var(--accent);
    animation: scrollwheel 1.6s var(--ease) infinite;
  }
  @keyframes scrollwheel {
    0% { opacity: 0; transform: translateY(-3px); }
    35% { opacity: 1; }
    70% { opacity: 0; transform: translateY(7px); }
    100% { opacity: 0; }
  }
  .hero__scroll:hover {
    color: var(--accent);
  }
  .hero__scroll:hover .hero__mouse {
    border-color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__fx { opacity: 0.85; }
    .hero__wheel { animation: none; }
  }
  @media (max-width: 560px) {
    .hero__scroll { display: none; }
  }
</style>
