---
import { profile } from '../data/site';

const scholar = profile.socials.find((s) => s.label === 'Google Scholar');
const email = profile.socials.find((s) => s.label === 'Email');
const x = profile.socials.find((s) => s.label === 'X');
const linkedin = profile.socials.find((s) => s.label === 'LinkedIn');
const orcid = profile.socials.find((s) => s.label === 'ORCID');

// hero shell tagline: split the motto into a typed "command" + a revealed "output"
const _shell = profile.tagline.en.split(' -> ');
const shellCmd = _shell[0] ?? '';
const shellOut = _shell[1] ?? '';
---

<section class="hero" id="top">
  <div class="container hero__inner">
    <div class="hero__content" data-reveal>
      <img class="hero__avatar" src="/avatar.jpg" alt={profile.name} width="96" height="96" loading="eager" />
      <h1 class="hero__name">{profile.name} <span class="hero__name-zh">({profile.nameZh})</span></h1>
      <p class="hero__role">Researcher · {profile.affiliation}</p>
      <p class="hero__lede hero__shell mono" aria-label={profile.tagline.en}>
        <span class="sr-only">{profile.tagline.en}</span>
        <span class="hero__shell-fx" aria-hidden="true">
          <span class="shell__row">
            <span class="shell__prompt">$</span><span class="shell__cmd" data-text={shellCmd}></span><span class="shell__caret"></span>
          </span>
          <span class="shell__row shell__row--out">
            <span class="shell__out" data-text={shellOut}></span>
          </span>
        </span>
      </p>

      <div class="hero__socials">
        <button class="hero__social-link hero__social-link--home" type="button" data-copy-cycle="mingchaosun.com,mcsun.cn,mcs0.com,mcsun.com.cn,mingchaosun.github.io" title="Copy a site link — cycles through domains">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
          <span data-label>Main Page</span>
        </button>
        {scholar && (
          <a class="hero__social-link" href={scholar.url} target="_blank" rel="noopener noreferrer" title="Google Scholar">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 1 0 0-14z"></path></svg>
            Google Scholar
          </a>
        )}
        <button class="hero__social-link" type="button" data-copy={profile.wechat} title="Copy WeChat ID">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8.6 3C4 3 0 6.1 0 10.1c0 2.2 1.1 4.2 3 5.5l-1 2.9 3.3-1.7c1.1.3 2.2.4 3.3.4.1 0 .2 0 .3 0-1-4.2 2-7.8 6.4-7.8.4 0 .8 0 1.2.1C15 5.7 12 3 8.6 3zm-2.4 4c.6 0 1.1.5 1.1 1.1C7.3 8.7 6.8 9.1 6.2 9.1 5.6 9.1 5.1 8.7 5.1 8.1 5.1 7.6 5.6 7 6.2 7zm4.8 0c.6 0 1.1.5 1.1 1.1 0 .6-.5 1.1-1.1 1.1-.6 0-1.1-.5-1.1-1.1C9.9 7.6 10.4 7 11 7zM17.1 10.3c-3.5 0-6.4 2.4-6.4 5.4 0 3 2.9 5.4 6.4 5.4 1 0 2-.2 2.9-.6l2.9 1.5-.9-2.5c1.6-1.1 2.6-2.8 2.6-4.7 0-3-2.9-5.5-6.4-5.5zm-2.1 3.5c.5 0 .9.4.9.9s-.4.9-.9.9-.9-.4-.9-.9.4-.9.9-.9zm4.2 0c.5 0 .9.4.9.9s-.4.9-.9.9-.9-.4-.9-.9.4-.9.9-.9z"></path></svg>
            <span data-label>WeChat</span>
        </button>
        {email && (
          <a class="hero__social-link hero__social-link--icon" href={email.url} title="Email" aria-label="Email sun.mc@outlook.com">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </a>
        )}
        {x && (
          <a class="hero__social-link hero__social-link--icon" href={x.url} target="_blank" rel="noopener noreferrer" title="X (@mingchao_sun)" aria-label="X profile">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"></path></svg>
          </a>
        )}
        {linkedin && (
          <a class="hero__social-link hero__social-link--icon" href={linkedin.url} target="_blank" rel="noopener noreferrer" title="LinkedIn" aria-label="LinkedIn profile">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"></path></svg>
          </a>
        )}
        {orcid && (
          <a class="hero__social-link hero__social-link--orcid" href={orcid.url} target="_blank" rel="noopener noreferrer" title="ORCID iD" aria-label="ORCID profile">
            <span class="hero__orcid-id">iD</span>
          </a>
        )}
        <div class="hero__copy-toast" role="status" aria-live="polite"></div>
      </div>
    </div>
  </div>

  <a class="hero__scroll" href="#about" aria-label="Scroll to content">
    <span class="hero__scroll-txt mono">scroll</span>
    <span class="hero__mouse" aria-hidden="true"><span class="hero__wheel"></span></span>
  </a>
</section>

<script>
  // ---- Lightweight 2D interactive point-cloud (nod to point-cloud DL / 3DGS) ----
  // Fixed full-viewport background; drifts + forms a constellation only while the
  // cursor is in the window. Paused when the tab is hidden. reduced-motion → static.
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && canvas.getContext) {
    const ctx = canvas.getContext('2d')!;
    const dpr = Math.min(window.devicePixelRatio || 1, 1.5);

    // palette
    const MINT: [number, number, number] = [74, 227, 181]; // --accent
    const BLUE: [number, number, number] = [122, 162, 247]; // --accent-2

    let w = 0, h = 0;
    type P = { x: number; y: number; vx: number; vy: number; r: number; t: number; base: [number, number, number] };
    let pts: P[] = [];

    // mouse in CSS pixels, relative to hero
    const mouse = { x: -9999, y: -9999, on: false };
    const REACH = 180; // px — radius of cursor influence
    const LINK = 132; // px — max distance to draw a link between two near-cursor points
    const REACH2 = REACH * REACH;
    const LINK2 = LINK * LINK;

    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    // a point's idle color (mint→blue by t) is constant — precompute it once
    const baseColor = (t: number): [number, number, number] => [
      (lerp(MINT[0], BLUE[0], t) + 0.5) | 0,
      (lerp(MINT[1], BLUE[1], t) + 0.5) | 0,
      (lerp(MINT[2], BLUE[2], t) + 0.5) | 0,
    ];

    // cached cursor-glow gradient — rebuilt only when the cursor actually moves
    let glowGrad: CanvasGradient | null = null;
    let glowKey = '';

    const seed = (n: number) => {
      pts = Array.from({ length: n }, () => {
        const t = Math.random();
        return {
          x: Math.random() * w,
          y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.22,
          vy: (Math.random() - 0.5) * 0.22,
          r: Math.random() * 1.1 + 0.7,
          t,
          base: baseColor(t),
        };
      });
    };

    const resize = () => {
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = Math.max(1, Math.round(w * dpr));
      canvas.height = Math.max(1, Math.round(h * dpr));
      canvas.style.width = w + 'px';
      canvas.style.height = h + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const target = Math.min(110, Math.max(40, Math.round((w * h) / 17000)));
      if (pts.length !== target) seed(target);
    };

    const render = () => {
      ctx.clearRect(0, 0, w, h);

      // soft glow hugging the cursor (gradient cached per cursor position)
      if (mouse.on) {
        const key = mouse.x + ',' + mouse.y;
        if (key !== glowKey) {
          const g = ctx.createRadialGradient(mouse.x, mouse.y, 0, mouse.x, mouse.y, REACH);
          g.addColorStop(0, 'rgba(74,227,181,0.10)');
          g.addColorStop(1, 'rgba(74,227,181,0)');
          glowGrad = g;
          glowKey = key;
        }
        ctx.fillStyle = glowGrad!;
        ctx.beginPath();
        ctx.arc(mouse.x, mouse.y, REACH, 0, Math.PI * 2);
        ctx.fill();
      }

      // points near the cursor — for linking
      const near: P[] = [];
      if (mouse.on) {
        for (const p of pts) {
          const dx = p.x - mouse.x, dy = p.y - mouse.y;
          if (dx * dx + dy * dy < REACH2) near.push(p);
        }
      }

      // constellation links among near-cursor points
      if (near.length > 1) {
        ctx.lineWidth = 1;
        for (let i = 0; i < near.length; i++) {
          const a = near[i];
          for (let j = i + 1; j < near.length; j++) {
            const b = near[j];
            const dx = a.x - b.x, dy = a.y - b.y;
            const d2 = dx * dx + dy * dy;
            if (d2 < LINK2) {
              const alpha = (1 - Math.sqrt(d2) / LINK) * 0.5;
              ctx.strokeStyle = 'rgba(74,227,181,' + alpha + ')';
              ctx.beginPath();
              ctx.moveTo(a.x, a.y);
              ctx.lineTo(b.x, b.y);
              ctx.stroke();
            }
          }
        }
      }

      // draw all points; brighten those near the cursor
      for (const p of pts) {
        let hot = 0;
        if (mouse.on) {
          const dx = p.x - mouse.x, dy = p.y - mouse.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < REACH2) hot = 1 - Math.sqrt(d2) / REACH; // 0..1
        }
        // brighten the precomputed idle color toward white by `hot`
        const b = p.base;
        const rr = (b[0] + (255 - b[0]) * hot * 0.4) | 0;
        const gg = (b[1] + (255 - b[1]) * hot * 0.4) | 0;
        const bb = (b[2] + (255 - b[2]) * hot * 0.4) | 0;
        // dissolve points toward the top/bottom edges so the cloud fades out
        // instead of cutting at a hard horizontal line
        const fadeBand = h * 0.14;
        let edge = 1;
        if (p.y < fadeBand) edge = p.y / fadeBand;
        else if (p.y > h - fadeBand) edge = (h - p.y) / fadeBand;
        if (edge < 0) edge = 0;
        const a = (0.35 + hot * 0.6 + p.t * 0.05) * edge;
        const rad = p.r * (1 + hot * 1.8);
        ctx.fillStyle = 'rgba(' + rr + ',' + gg + ',' + bb + ',' + (a > 1 ? 1 : a) + ')';
        ctx.beginPath();
        ctx.arc(p.x, p.y, rad, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    const step = () => {
      for (const p of pts) {
        p.x += p.vx;
        p.y += p.vy;
        // wrap around the hero edges
        if (p.x < -10) p.x = w + 10;
        else if (p.x > w + 10) p.x = -10;
        if (p.y < -10) p.y = h + 10;
        else if (p.y > h + 10) p.y = -10;
      }
      render();
    };

    let raf = 0;
    let visible = true;
    let pointerIn = false; // the cloud only animates while the cursor is in the window

    // run only when: tab visible, cursor in window, motion allowed.
    // Idle (no hover / hidden tab) → zero rAF cost.
    const shouldRun = () => visible && pointerIn && !reduce;

    const loop = () => {
      if (!shouldRun()) return;
      step();
      raf = requestAnimationFrame(loop);
    };
    const start = () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(loop); };
    const stop = () => cancelAnimationFrame(raf);

    // pointer → viewport coords (canvas is pointer-events:none and fills the viewport)
    const onMove = (e: PointerEvent) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
      mouse.on = true;
      if (!pointerIn) {
        pointerIn = true;
        if (shouldRun()) start();
      }
    };
    // pointer left the window entirely
    const onWinLeave = () => {
      if (!pointerIn) return;
      pointerIn = false;
      mouse.on = false;
      mouse.x = mouse.y = -9999;
      stop();
      render(); // repaint a clean static frame
    };
    window.addEventListener('pointermove', onMove, { passive: true });
    window.addEventListener('mouseout', (e) => { if (!e.relatedTarget) onWinLeave(); }, { passive: true });

    // pause when tab hidden
    document.addEventListener('visibilitychange', () => {
      visible = document.visibilityState === 'visible';
      if (shouldRun()) start(); else stop();
    });

    resize();
    window.addEventListener('resize', resize, { passive: true });

    // render a single static frame up front; the cloud animates only while hovered
    if (reduce) {
      mouse.on = true;
      mouse.x = w / 2;
      mouse.y = h * 0.42;
    }
    render();
  }
</script>

<script>
  // hero shell tagline: type the command, then reveal the "output" (the dream)
  const shellRoot = document.querySelector('.hero__shell');
  if (shellRoot) {
    const cmd = shellRoot.querySelector<HTMLElement>('.shell__cmd');
    const out = shellRoot.querySelector<HTMLElement>('.shell__out');
    const caret = shellRoot.querySelector<HTMLElement>('.shell__caret');
    const outRow = shellRoot.querySelector<HTMLElement>('.shell__row--out');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cmdText = cmd?.dataset.text ?? '';
    const outText = out?.dataset.text ?? '';

    if (reduce || !cmdText) {
      // static fallback: show the full motto immediately
      if (cmd) cmd.textContent = cmdText;
      if (out) { out.textContent = outText; out.classList.add('is-shown'); }
    } else {
      let i = 0;
      const typeCmd = () => {
        if (cmd) cmd.textContent = cmdText.slice(0, i);
        i += 1;
        if (i <= cmdText.length) {
          window.setTimeout(typeCmd, 42);
        } else {
          // "enter" → caret drops to the output line, the dream fades in
          window.setTimeout(() => {
            if (outRow && caret) outRow.appendChild(caret);
            if (out) { out.textContent = outText; out.classList.add('is-shown'); }
          }, 360);
        }
      };
      window.setTimeout(typeCmd, 400); // let the hero settle before "typing"
    }
  }
</script>

<script>
  // click any WeChat chip → copy the ID to the clipboard, flash "copied"
  const wcBtns = document.querySelectorAll('[data-copy]');
  wcBtns.forEach((btn) => {
    if (!(btn instanceof HTMLElement)) return;
    const label = btn.querySelector<HTMLElement>('[data-label]');
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-copy') || '';
      let ok = false;
      try {
        await navigator.clipboard.writeText(id);
        ok = true;
      } catch {
        const ta = document.createElement('textarea');
        ta.value = id;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { ok = document.execCommand('copy'); } catch {}
        ta.remove();
      }
      if (ok && label) {
        // the label may hold bilingual spans — restore the markup, not just text
        const prev = label.innerHTML;
        label.textContent = 'copied';
        btn.classList.add('is-copied');
        setTimeout(() => {
          label.innerHTML = prev;
          btn.classList.remove('is-copied');
        }, 1500);
      }
    });
  });
</script>

<script>
  // Main-Page button: each click copies the NEXT site address in turn —
  // mingchaosun.com → mcsun.cn → mcs0.com → mcsun.com.cn → mingchaosun.github.io
  // → repeat. The chip pulses bright-mint and a toast pops beneath the row
  // reading "✓ <domain> copied" (kept off the chip so a long address reads
  // clearly on phones too).
  document.querySelectorAll('[data-copy-cycle]').forEach((el) => {
    const btn = el instanceof HTMLElement ? el : null;
    if (!btn) return;
    const domains = (btn.dataset.copyCycle || '')
      .split(',')
      .map((s) => s.trim())
      .filter(Boolean);
    if (!domains.length) return;
    const toast = btn.closest('.hero__socials')?.querySelector<HTMLElement>('.hero__copy-toast');
    let i = 0;
    let pulseTimer = 0;
    let toastTimer = 0;

    const copy = async (text: string) => {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {}
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      let ok = false;
      try { ok = document.execCommand('copy'); } catch {}
      ta.remove();
      return ok;
    };

    btn.addEventListener('click', async () => {
      const domain = domains[i];
      i = (i + 1) % domains.length; // advance so the next click copies the next address
      const ok = await copy('https://' + domain);
      if (!ok) return;
      btn.classList.add('is-copied');
      window.clearTimeout(pulseTimer);
      pulseTimer = window.setTimeout(() => btn.classList.remove('is-copied'), 1400);
      if (toast) {
        toast.textContent = '✓ ' + domain + ' copied';
        toast.classList.add('is-visible');
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => toast.classList.remove('is-visible'), 1400);
      }
    });
  });
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    min-height: min(82vh, 720px);
    display: flex;
    align-items: center;
    padding-block: clamp(3.5rem, 9vw, 6rem) clamp(4rem, 8vw, 6rem);
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  .hero__content {
    max-width: 640px;
  }
  .hero__avatar {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border);
    box-shadow:
      0 0 0 6px rgba(74, 227, 181, 0.05),
      0 10px 30px -10px rgba(0, 0, 0, 0.6);
    margin-bottom: 1.3rem;
  }
  .hero__name {
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .hero__name-zh {
    font-size: 0.36em;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    margin-left: 0.18em;
    white-space: nowrap;
  }
  .hero__role {
    color: var(--text);
    font-weight: 600;
    font-size: clamp(1rem, 2.2vw, 1.18rem);
    margin-top: 0.55rem;
    letter-spacing: 0.01em;
  }
  .hero__lede {
    color: var(--text-muted);
    font-size: clamp(0.85rem, 1.6vw, 1rem);
    line-height: 1.6;
    max-width: 60ch;
    margin-top: 0.7rem;
  }
  .hero__shell {
    font-family: var(--mono);
    line-height: 1.55;
    letter-spacing: 0.01em;
  }
  .hero__shell .shell__row { display: block; }
  .hero__shell .shell__prompt { color: var(--accent); margin-right: 0.45ch; }
  .hero__shell .shell__cmd { color: var(--text-muted); }
  .hero__shell .shell__out {
    color: var(--accent);
    opacity: 0;
    transition: opacity 0.32s var(--ease);
  }
  .hero__shell .shell__out.is-shown { opacity: 1; }
  .hero__shell .shell__caret {
    display: inline-block;
    width: 0.5ch;
    height: 1.02em;
    margin-left: 2px;
    background: var(--accent);
    vertical-align: -0.16em;
    animation: shell-blink 1.05s steps(1) infinite;
  }
  @keyframes shell-blink { 50% { opacity: 0; } }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__shell .shell__caret { animation: none; }
  }

  .hero__socials {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.4rem;
  }
  /* confirmation toast that pops under the socials when the Main-Page button
     copies a link — shows "✓ <domain> copied". Kept off the chip itself so a
     long address (e.g. mingchaosun.github.io) reads clearly on phones too. */
  .hero__copy-toast {
    position: absolute;
    top: calc(100% + 0.55rem);
    left: 0;
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius-sm);
    background: var(--bg-elev-2);
    border: 1px solid var(--accent);
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.76rem;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
    transition: opacity 0.18s var(--ease), transform 0.18s var(--ease);
    z-index: 5;
  }
  .hero__copy-toast.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .hero__social-link {
    display: inline-flex;
