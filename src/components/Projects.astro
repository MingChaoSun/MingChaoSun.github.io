---
import Section from './Section.astro';
import { projects } from '../data/site';
---

<Section id="projects" label="projects" title="Open-source & side projects">
  <div class="grid">
    {
      projects.map((p) => (
        <a class="card" href={p.url} data-reveal>
          <div class="card__head">
            <span class="card__icon mono">&gt;_</span>
            <span class="card__name mono">{p.name}</span>
          </div>
          <p class="card__blurb muted">{p.blurb}</p>
          <ul class="card__tags mono">
            {p.tags.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </a>
      ))
    }
  </div>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.2rem;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    background: var(--bg-elev);
    color: var(--text);
    transition: all 0.2s var(--ease);
  }
  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .card__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .card__icon {
    color: var(--accent);
  }
  .card__name {
    color: var(--text);
    font-weight: 600;
  }
  .card__blurb {
    font-size: 0.9rem;
  }
  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }
  .card__tags li {
    font-size: 0.72rem;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 0.1em 0.5em;
    border-radius: 999px;
  }
</style>
