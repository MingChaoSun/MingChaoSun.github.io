---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';
import Lang from '../components/Lang.astro';

export interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Mingchao Sun — Algorithm Tech Lead · 3D & World Models',
  description =
    'Mingchao Sun — Algorithm Tech Lead at Alibaba (Amap). Research on 3D reconstruction & generation, 3D Gaussian Splatting, point-cloud deep learning and generative world models. Author of PointCNN.',
} = Astro.props;

const site = Astro.site ?? 'https://mingchaosun.com';
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL('/og.png', site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Mingchao Sun" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0d12" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mingchao Sun — Algorithm Tech Lead · 3D & World Models" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <!-- apply saved language before paint to avoid a flash -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('lang') === 'zh') {
            document.documentElement.classList.add('lang-zh');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">skip to content</a>
    <Lang />
    <slot />

    <script>
      // reveal-on-scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>

    <script is:inline>
      // 中 / EN toggle — flip the language class, update <html lang>, persist.
      var btn = document.getElementById('langToggle');
      if (btn) {
        btn.addEventListener('click', function () {
          var html = document.documentElement;
          var zh = html.classList.toggle('lang-zh');
          html.lang = zh ? 'zh' : 'en';
          try {
            localStorage.setItem('lang', zh ? 'zh' : 'en');
          } catch (e) {}
        });
      }
    </script>
  </body>
</html>
