---
import Layout from '../layouts/Layout.astro';
import TerminalHero from '../components/TerminalHero.astro';
import Section from '../components/Section.astro';
import Publications from '../components/Publications.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/site';
---

<Layout>
  <main>
    <TerminalHero />

    <Section id="about" label="about" title="Profile">
      <div class="about" data-reveal>
        <p>
          <strong>{profile.name}</strong> is a {profile.role} at {profile.affiliation}.
          My research spans world models, 3D Gaussian splatting, embodied navigation and deep learning
          on point clouds — from <a href="https://scholar.google.com/scholar?q=PointCNN">PointCNN</a> to
          the <a href="#work">ABot</a> series of interactive 3D worlds.
        </p>
        <p class="muted">
          {/* TODO: replace with the full narrative bio once the detailed profile lands. */}
          Full bio pending — education, career arc and a longer research statement will go here.
        </p>
      </div>
    </Section>

    <Publications />
    <Projects />
    <Contact />
  </main>
  <Footer />
</Layout>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 720px;
  }
  .about strong {
    color: var(--accent);
  }
</style>
